{
  "name": "luckycat",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "guide:dev": "pnpm --filter @luckycat/guide dev",
    "guide-internal:dev": "pnpm --filter @luckycat/guide-internal dev",
    "build": "pnpm -r build"
  }
}
