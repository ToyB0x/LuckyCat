{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luckycat-api-local",
  "main": "src/local.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "workflows": [
    {
      "binding": "GOOGLE_CONNECTION_CHECK",
      "name": "luckycat-local-connection-check",
      "class_name": "LocalConnectionCheck"
    }
  ],
  "d1_databases": [
    {
      "binding": "LOCAL_DIAGNOSTICS",
      "database_name": "luckycat-diagnostics-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
